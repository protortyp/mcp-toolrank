{
  "timeout_seconds": 30,
  "servers": [
    {
      "id": "clock",
      "transport": "streamable_http",
      "url": "http://127.0.0.1:8271/mcp",
      "discover": ["get_current_time"],
      "invoke": ["get_current_time"]
    },
    {
      "id": "repository",
      "command": "uvx",
      "args": ["--python", "3.12", "mcp-server-git==2026.11.18", "--repository", "."],
      "discover": ["git_status", "git_log", "git_diff_unstaged"]
    }
  ]
}
